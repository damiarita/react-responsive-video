{
  "name": "@damiarita/react-responsive-video",
  "description": "React component to improve performance of web pages with videos",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "eslint . && npx prettier --check . && jest",
    "build": "tsc",
    "docs": "typedoc",
